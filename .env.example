# 9Router WYx0 environment contract
# This file reflects the current WYx0 local setup and runtime defaults.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
# DATA_DIR=./.data-wyx0

# Recommended runtime variables
PORT=20129
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=wyx0-endpoint-proxy-api-key
MACHINE_ID_SALT=wyx0-endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Optional cookie names. Use WYx0-specific names when running beside original 9Router
# on the same hostname, because browser cookies are shared across ports.
AUTH_TOKEN_COOKIE_NAME=wyx_auth_token
OIDC_STATE_COOKIE_NAME=wyx_oidc_state
OIDC_NONCE_COOKIE_NAME=wyx_oidc_nonce
OIDC_VERIFIER_COOKIE_NAME=wyx_oidc_code_verifier

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20129
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20129
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional Kiro debugging
# By default, Kiro reasoning/thinking chunks are hidden from client streams.
# KIRO_EXPOSE_REASONING=false

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router-wyx0

# ── IMAP OTP reader (optional) ────────────────────────────────────
# Auto-solves GitHub's Device Verification screen during the CodeBuddy
# GitHub bulk-import automation. When these are set the flow reads the
# verification code from your inbox via IMAP; when unset the account
# flips to needs_manual on the verify page so the operator can type
# the code by hand.
#
# For Gmail, IMAP_PASS must be an App Password (Gmail blocks regular
# passwords for IMAP login). Create one at:
#   https://myaccount.google.com/apppasswords
# Enable catch-all forwarding at your domain provider (e.g. Cloudflare
# Email Routing) so mail addressed to *@yourdomain.com lands in this
# Gmail inbox — the automation matches by recipient address.
#
# IMAP_USER=you@gmail.com
# IMAP_PASS=abcd efgh ijkl mnop
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993

# ── Privatix Temp-Mail (optional) ─────────────────────────────────
# Used by the CodeBuddy Global GitHub-register bulk automation to
# allocate disposable email addresses for fresh GitHub signups. Every
# account in a batch lands on a DIFFERENT Privatix domain so CodeBuddy's
# "same-domain within window" abuse heuristic does not flag the batch.
#
# Provider selection (default: tempmailorg):
#   TEMPMAIL_PROVIDER=tempmailorg  → web2.temp-mail.org web API (NO key
#                                    required, larger/less-flagged domain
#                                    pool). RECOMMENDED — GitHub's abuse
#                                    team has flagged the Privatix domain
#                                    pool (@amozix.com, @cevipsa.com, …)
#                                    for years, causing freshly-created
#                                    accounts to shadow-ban within seconds.
#   TEMPMAIL_PROVIDER=privatix     → Privatix (RapidAPI). Requires the
#                                    TEMPMAIL_RAPIDAPI_KEY below.
# TEMPMAIL_PROVIDER=tempmailorg
#
# Get your Privatix key from https://rapidapi.com/Privatix/api/temp-mail —
# only needed when TEMPMAIL_PROVIDER=privatix. The free plan is enough for
# smoke tests, larger batches need a paid tier because polling for OTPs
# consumes several requests per account.
# TEMPMAIL_RAPIDAPI_KEY=your-rapidapi-key-here
